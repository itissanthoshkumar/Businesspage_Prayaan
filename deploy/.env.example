# Prayaan Business Pages — production environment.
# Copy to .env and fill in. The app REFUSES TO BOOT when the required values
# are missing or shaped wrong (see store.boot_checks / main._startup_checks) —
# a loud no at startup instead of a quiet security hole at 2am.

# --- required ---------------------------------------------------------------
# Sessions, CSRF and IP-hash keying. Generate:  openssl rand -hex 32
PBN_SECRET_KEY=

# Public origin — used in canonical URLs, OG tags, sitemap, admin address echo.
PBN_BASE_URL=https://business.prayaancapital.com

# PBN's OWN database. NEVER dpd_early_warning (Sherlock's) — boot check refuses.
PBN_MONGO_DB=pbn

# Three DIFFERENT Atlas users; the boot check refuses shared ones and verifies
# the RW user cannot read leads.
#   RO    — read business_pages only (serves public pages)
#   RW    — insert-only: site_leads, page_reports, counters (the anonymous forms)
#   ADMIN — read/write all PBN collections (the back-office)
PBN_MONGO_URI_RO=
PBN_MONGO_URI_RW=
PBN_MONGO_URI_ADMIN=

# --- posture (defaults already set in the Dockerfile) ------------------------
PBN_SHOW_SWITCHER=false        # review surfaces + dev-login OFF; boot checks ON
PBN_PUBLIC_DIR=false           # /browse directory hidden
PBN_TRUST_PROXY=true           # behind Caddy ONLY — never when exposed directly

# --- lead & report alerts -----------------------------------------------------
# Set AT LEAST ONE channel. With neither, new leads sit unseen in /admin/leads
# and the boot log carries a warning. Webhook = any endpoint taking JSON POST
# (Google Chat space webhook works as-is).
PBN_NOTIFY_WEBHOOK=
PBN_NOTIFY_EMAIL_TO=
PBN_SMTP_HOST=
PBN_SMTP_PORT=587
PBN_SMTP_USER=
PBN_SMTP_PASS=
PBN_SMTP_FROM=

# --- observability ------------------------------------------------------------
# Optional Sentry (pip install sentry-sdk in the image first) and/or a rotating
# error-log file. stderr always carries errors either way (docker logs).
PBN_SENTRY_DSN=
PBN_ERROR_LOG=

# --- tuning (defaults are fine) -------------------------------------------------
# PBN_LEAD_CAP_IP=40
# PBN_LEAD_CAP_GLOBAL=2000
# PBN_REPORT_CAP_IP=10
# PBN_REPORT_CAP_GLOBAL=200
# PBN_DEFAULT_VARIANT=27
